@using DemoProject.Application.Shared.Dto.Books
@{
    ViewBag.Title = "Quản lý Sách";
    // Ép kiểu IEnumerable để nhận an toàn danh sách Category
    var categories = ViewBag.Categories as IEnumerable<CategoryDto> ?? new List<CategoryDto>();
}

@section scripts
{
    <script src="~/view-resources/Views/Books/Index.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Books/_EditModal.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý Sách</h1>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" class="btn btn-primary" id="CreateNewBookButton" data-toggle="modal" data-target="#BookCreateModal" data-bs-toggle="modal" data-bs-target="#BookCreateModal">
                    <i class="fa fa-plus-square"></i> Thêm mới
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <input type="text" id="SearchKeyword" class="form-control" placeholder="Nhập tên sách hoặc tác giả..." />
                            <div class="input-group-append">
                                <button type="button" id="SearchButton" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="BooksTable" class="table table-striped table-bordered w-100">
                        <thead>
                            <tr>
                                <th style="width: 50px" class="text-center">STT</th>
                                <th>Tên sách</th>
                                <th>Tác giả</th>
                                <th>Giá sách</th>
                                <th>Danh mục</th>
                                <th style="width: 150px" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Thêm mới -->
<div class="modal fade" id="BookCreateModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm mới Sách</h5>
                <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form name="BookCreateForm" role="form" class="form-horizontal">
                <div class="modal-body">
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Tên sách <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input 
                                type="text" 
                                class="form-control" 
                                name="Title" 
                                required 
                                maxlength="100" 
                                data-msg-required="Vui lòng nhập tên sách."
                                data-msg-maxlength="Tên sách không được vượt quá 100 ký tự."
                            >
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Tác giả <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input 
                                type="text" 
                                class="form-control" 
                                name="Author" 
                                required 
                                maxlength="100" 
                                data-msg-required="Vui lòng nhập tên tác giả."
                                data-msg-maxlength="Tên tác giả không được vượt quá 100 ký tự."
                            >
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Giá sách <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <input 
                                type="number" 
                                step="1000" 
                                min="0" 
                                max="999999999" 
                                class="form-control" 
                                name="Price" 
                                required 
                                data-msg-required="Vui lòng nhập giá sách." 
                                data-msg-min="Giá sách không được nhỏ hơn 0 đ." 
                                data-msg-max="Giá sách quá lớn."
                            >
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Danh mục <span class="text-danger">*</span></label>
                        <div class="col-md-9">
                            <select class="form-control" name="CategoryId" required data-msg-required="Vui lòng chọn danh mục.">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Container Modal Sửa -->
<div class="modal fade" id="BookEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>